#!/usr/bin/env sh

echo "🔍 Verificando tipos TypeScript..."
pnpm run type:check

if [ $? -ne 0 ]; then
  echo "❌ Type check error. Fix before pushing."
  exit 1
fi

echo "✅ Type check passed!"

echo "🔍 Rodando lint-staged..."
pnpm exec lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Lint/format error. Fix before committing."
  exit 1
fi

echo "✅ Lint-staged passed!"